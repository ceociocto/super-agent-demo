{
  "name": "superagent-enterprise-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Standalone model-driven personal multitask assistant with Router and Workers",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "executor:start": "bash scripts/start-executor.sh",
    "executor:build": "bash scripts/setup-executor.sh",
    "test:executor": "node scripts/verify-executor.mjs",
    "test:model": "node --env-file-if-exists=.env scripts/verify-model.mjs",
    "test:assistant": "node --env-file-if-exists=.env scripts/verify-assistant.mjs",
    "mcp": "node scripts/mcp.mjs",
    "assistant": "node scripts/client.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
