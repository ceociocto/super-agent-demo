# Independent GLM configuration. Never commit a real key.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3
GLM_REASONING_EFFORT=low
GLM_MAX_TOKENS=8192
GLM_TIMEOUT_MS=120000
PORT=4317

# To switch to another OpenAI-compatible provider, set all three together.
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model-name
# MODEL_API_KEY=
# Optional secret-free config file (default: ./config.local.json).
# ASSISTANT_CONFIG=/absolute/path/to/config.local.json
# MODEL_TIMEOUT_MS=120000
# MODEL_MAX_TOKENS=8192
# MODEL_REASONING_EFFORT=low
