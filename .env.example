# 复制本文件：cp .env.example .env
# 然后编辑 .env，填写自己的 API Key。不要将 .env 或真实密钥提交到 Git。
# 已存在的系统环境变量优先于 .env；修改后请重启服务。

# 模型接口必须兼容 OpenAI Chat Completions 与工具调用。
# Base URL 填接口前缀，不要追加 /chat/completions。
# 以下是 GLM Coding 示例，按账号支持的模型名称调整：
MODEL_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
MODEL_NAME=glm-5.3
MODEL_API_KEY=

# 切换供应商时，同时更换以上三个值，例如：
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model-name
# MODEL_API_KEY=your-api-key

# 可选：输出上限和请求超时（毫秒）。
# MODEL_MAX_TOKENS=8192
# MODEL_TIMEOUT_MS=120000
# 某些兼容接口要求 max_completion_tokens；默认是 max_tokens。
# MODEL_MAX_TOKENS_FIELD=max_completion_tokens
# 若供应商支持 reasoning_effort，可按其文档设置：
# MODEL_REASONING_EFFORT=low

# 可选：高级 JSON 配置路径。若配置了 apiKeyEnv，密钥从指定变量读取。
# ASSISTANT_CONFIG=/absolute/path/to/config.local.json
# 可选：网页端口，默认 4317。
# PORT=4317
